# 忽略编译生成的中间文件
*.o
*.ko
*.mod
*.mod.c
*.order
*.symvers
*.cmd
.tmp_versions/
*.lds
*.usyms
lsdriver/arm64_ptedbg-20260822-000439.h
!lsdriver/byte_stream/
!lsdriver/byte_stream/*.ko

# 忽略 VS Code 配置
.vscode/
.claude/
.codex/
# android build outputs
android/obj/
android/libomp.a
android/libomp.so
obj/
/libs/
windows/__pycache__/
*.pyc
**/.pyinstaller/

# Build dependency files
*.o.d
*.d

# VS Code settings in subdirectories
**/.vscode/

# Keep the complete ARM64 test tree, including generated test artifacts
!lsdriver/arm64_tests/
!lsdriver/arm64_tests/**

# Android Studio / Gradle / NDK outputs
.gradle/
.idea/
*.iml
local.properties
build/
out/
captures/
.cxx/
.externalNativeBuild/

